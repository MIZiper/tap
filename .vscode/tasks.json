{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DAC: PostgreSQL",
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/dac_web/backend"
            },
            "command": "podman run -it --rm --name dac_postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=dac -p 5431:5432 -v ./dac_web/db/:/docker-entrypoint-initdb.d/ postgres"
        },
        {
            "label": "DAC: backend",
            "type": "shell",
            "problemMatcher": ["$python"],
            "options": {
                "cwd": "${workspaceFolder}/dac_web/backend",
                "env": {
                    "APP_LOG_ON": "1",
                    "DBSTORE": "true",
                    "LOG_DIR": "../storage/logs/",
                    "PROJECT_DIR": "../storage/projects/",
                    "POSTGRES_PORT": "5431",
                    "KEYCLOAK_URL": "http://localhost:8080",
                    "KEYCLOAK_URL_PUBLIC": "http://localhost:8080",
                    "KEYCLOAK_REALM": "master",
                    "KEYCLOAK_CLIENT_ID": "miz",
                    "KEYCLOAK_CLIENT_SECRET": "",
                    "PUBLIC_BASE_URL": "http://localhost:5131",
                    "EXTERNAL_SYSTEM": "tc",
                    "EXTERNAL_SYSTEM_URL": "http://localhost:8030",
                    "EXTERNAL_SYSTEM_UI_URL": "http://localhost:5130",
                    "EXTERNAL_FROZEN_STATUSES": "pending_review,published,archived"
                }
            },
            "command": "until pg_isready -h localhost -p 5431; do echo 'Waiting for Postgres...'; sleep 1; done && uv run uvicorn --reload --port=8031 dac_web.main:app"
        },
        {
            "label": "DAC: frontend",
            "type": "shell",
            "problemMatcher": ["$tsc"],
            "options": {
                "cwd": "${workspaceFolder}/dac_web/dac-frontend",
                "env": {
                    "VITE_API_PORT": "8031"
                }
            },
            "command": "until /bin/nc -z localhost 8031; do sleep 1; done && pnpm run dev --port 5131 --open"
        },
        {
            "label": "DAC",
            "dependsOrder": "parallel",
            "dependsOn": [
                "DAC: PostgreSQL",
                "DAC: backend",
                "DAC: frontend"
            ],
            "group": "build"
        },
        {
            "label": "TC: PostgreSQL",
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/rdb/tc-backend"
            },
