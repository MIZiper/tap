        {
            "label": "RDB: Full",
            "dependsOrder": "parallel",
            "dependsOn": [
                "MetaHub: PostgreSQL",
                "MetaHub: backend",
                "MetaHub: frontend",
                "TC: PostgreSQL",
                "TC: backend",
                "TC: frontend"
            ],
            "group": "build"
        },
        {
            "label": "TPL: PostgreSQL",
            "type": "shell",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/tpl/tpl-backend"
            },
            "command": "podman run -it --rm --name tpl_postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=tpl -p 5437:5432 -v ./tpl/sql/:/docker-entrypoint-initdb.d/ docker.io/library/postgres:18"
        },
        {
            "label": "TPL: backend",
            "type": "shell",
            "problemMatcher": ["$python"],
            "options": {
                "cwd": "${workspaceFolder}/tpl/tpl-backend",
                "env": {
                    "DATABASE_URL": "postgresql://postgres:password@localhost:5437/tpl",
                    "POSTGRES_PORT": "5437",
                    "KEYCLOAK_URL": "http://localhost:8080",
                    "KEYCLOAK_URL_PUBLIC": "http://localhost:8080",
                    "KEYCLOAK_REALM": "master",
                    "KEYCLOAK_CLIENT_ID": "miz",
                    "KEYCLOAK_CLIENT_SECRET": "",
                    "PUBLIC_BASE_URL": "http://localhost:5137",
                    "EXTERNAL_SYSTEM": "tc",
                    "EXTERNAL_SYSTEM_URL": "http://localhost:8030",
                    "EXTERNAL_SYSTEM_UI_URL": "http://localhost:5130",
                    "EXTERNAL_FROZEN_STATUSES": "pending_review,published,archived"
                }
            },
            "command": "until pg_isready -h localhost -p 5437; do echo 'Waiting for Postgres...'; sleep 1; done && uv run uvicorn --reload --port=8037 tpl.main:app"
        },
        {
            "label": "TPL: frontend",
            "type": "shell",
            "problemMatcher": ["$tsc"],
            "options": {
                "cwd": "${workspaceFolder}/tpl/tpl-frontend",
                "env": {
