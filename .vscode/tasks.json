        },
        {
            "label": "TC: backend",
            "type": "shell",
            "problemMatcher": ["$python"],
            "options": {
                "cwd": "${workspaceFolder}/rdb/tc-backend",
                "env": {
                    "POSTGRES_PORT": "5430",
                    "KEYCLOAK_URL": "http://localhost:8080",
                    "KEYCLOAK_URL_PUBLIC": "http://localhost:8080",
                    "KEYCLOAK_REALM": "master",
                    "KEYCLOAK_CLIENT_ID": "miz"
                }
            },
            "command": "until pg_isready -h localhost -p 5430; do echo 'Waiting for Postgres...'; sleep 1; done && uv run uvicorn --reload --port=8030 tc.main:app"
        },
        {
            "label": "TC: frontend",
            "type": "shell",
            "problemMatcher": ["$tsc"],
            "options": {
                "cwd": "${workspaceFolder}/rdb/tc-frontend",
                "env": {
                    "VITE_API_PORT": "8030"
                }
            },
            "command": "until /bin/nc -z localhost 8030; do sleep 1; done && pnpm run dev --port 5130 --open"
        },
